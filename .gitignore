# Build output - binaries only.
build/
bin/
obj/
TestResults/

# The Keeper home (tenant settings and data) and the demo home. Keeper accepts a home inside this
# folder only when these two lines are here - keep them.
/home/
/demo/

# Per-client folders: each client's own config\ (systems, integrations, thresholds, overrides) and
# data\ (collected findings/runs). Tenant data - never in the public repo.
/clients/

# Tenant files - a backstop in case one lands in the repo anyway
settings.json
denylist.txt
*.db
*.sqlite

# IDE
.vs/
.vscode/
*.user

# Local tools built for development (the rule validator)
artifacts/
