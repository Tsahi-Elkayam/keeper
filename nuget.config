<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore from nuget.org only, whatever sources the machine has configured. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Every package maps to nuget.org, so no other feed can supply a package with the same name. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
